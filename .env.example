# ============================================================
# Wioos Witness — environment template. Copy values into
# Railway Variables. NEVER commit a real .env file.
# ============================================================

# --- Telegram (required) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- External AI API (required, OpenAI-compatible) ---
# Base URL WITHOUT trailing slash, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- ChromaDB (required) ---
# e.g. https://api.trychroma.com:8000 (self-hosted URL also works)
CHROMA_URL=
CHROMA_DATABASE=
CHROMA_APIKEY=
CHROMA_SECRET=

# --- Redeem codes (initial seed only; usage state lives in the DB) ---
REDEEM_CODE_1=
REDEEM_CODE_2=
REDEEM_CODE_3=
REDEEM_CODE_4=
REDEEM_CODE_5=
REDEEM_CODE_6=
REDEEM_CODE_7=
REDEEM_CODE_8=

# --- Admin ---
# Telegram UID allowed to use /admin and /addcredit (optional)
ADMIN_TELEGRAM_ID=

# --- Optional tuning ---
# MODEL_DIR=/data/models
# INITIAL_CREDIT=100
# MAX_VOICE_CHARS=1200
# MAX_SVG_PROMPT_CHARS=800
# MAX_GLOBAL_JOBS=2
# MAX_JOBS_PER_USER=1
# AI_TIMEOUT_SECONDS=90
# TTS_TIMEOUT_SECONDS=90
# TMP_VOICE_DIR=/tmp/voice
# TMP_SVG_DIR=/tmp/svg
